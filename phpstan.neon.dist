includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 8
  # Filter results come from other plugins, so the runtime type checks that
  # follow apply_filters() are not dead code, whatever the docblock says.
  treatPhpDocTypesAsCertain: false
  paths:
    - src
    - agent-studio.php
    - uninstall.php
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    - stubs/wordpress-ai-client.php
  bootstrapFiles:
    # Declarations for the WordPress 7.0 AI Client facade, which the
    # WordPress stubs do not describe. Static analysis only.
    - stubs/wp-ai-client.php
    - stubs/agent-studio-constants.php
  # Domain and Application must stay free of WordPress. The architecture test
  # in tests/unit/ArchitectureTest.php enforces that at test time.
