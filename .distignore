# .distignore — files and directories excluded from the release zip.
# `npm run package` rsyncs the working tree to dist/<slug>/ honoring this file.
# Anything not listed here gets shipped, INCLUDING build/ (compiled assets) and
# vendor/ (populated by `composer install --no-dev` at release time).
#
# assets/src is the admin app's source; Vite compiles it into build/assets.
# assets/admin.css is loaded directly, so the rest of assets/ ships.

# Every hidden file and folder at the top level (.git, .github, .claude, ...),
# including any added later. Re-include one in .distinclude if it must ship.
/.*

# VCS
.git
.gitignore
.gitattributes
.gitkeep
.github
.cursor

# Devcontainer / IDE
.devcontainer
.editorconfig
.vscode
.idea

# Environment
.env
.env.example
.env.local
.env.testing

# Node + Composer toolchain
node_modules
.nvmrc
package.json
package-lock.json
composer.json
composer.lock

# Tests
tests
phpunit.xml.dist
phpcs.xml.dist
phpstan.neon.dist
playwright.config.ts
playwright-report
test-results
.phpunit.cache
.phpunit.result.cache
coverage

# Build tooling
Makefile
vite.config.js
eslint.config.mjs
.prettierrc.json
.prettierignore
.npmrc
stubs
bin
scripts

# Admin app source (compiled into build/assets)
/assets/src

# Docs and agent files
docs
AGENTS.md
CLAUDE.md
README.md
.distignore
.distinclude

# Build output (the zip lands here) and staging
build/*.zip

# Staging directory (this script writes here; never ship it)
dist

# OS junk
.DS_Store
Thumbs.db
