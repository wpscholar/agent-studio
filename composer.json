{
  "name": "wpscholar/agent-studio",
  "description": "Agent Studio — build AI agents inside WordPress that are triggered by site events, webhooks or direct calls and use WordPress abilities and skills.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wp-cli-stubs": "^2.11",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "AgentStudio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgentStudio\\Tests\\Support\\": "tests/support/",
      "AgentStudio\\Tests\\Unit\\": "tests/unit/",
      "AgentStudio\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyze": "phpstan analyse --memory-limit=2G",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite=unit",
    "test:integration": "phpunit --testsuite=integration",
    "test:coverage": "phpunit --coverage-clover=coverage.xml",
    "compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.2- src/"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true
  }
}
